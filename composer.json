{
    "name": "mozex/laravel-campaigns",
    "description": "Email campaigns that AI agents run inside your Laravel app over MCP, with lists synced from your users and paced sending through Mailgun on your own queue",
    "keywords": [
        "laravel",
        "email-marketing",
        "email-campaigns",
        "newsletter",
        "mailgun",
        "mcp",
        "ai-agents",
        "unsubscribe",
        "mozex"
    ],
    "homepage": "https://github.com/mozex/laravel-campaigns",
    "license": "MIT",
    "authors": [
        {
            "name": "Mozex",
            "email": "hello@mozex.dev",
            "homepage": "https://mozex.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "laravel/framework": "^12.69|^13.30",
        "laravel/mcp": "^1.1",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/http-client": "^7.4|^8.0",
        "symfony/mailgun-mailer": "^7.4|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8.2|^4.0.0|^5.0.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.0.0|^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^3.5|^4.0.0|^5.0.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mozex\\Campaigns\\": "src/",
            "Mozex\\Campaigns\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mozex\\Campaigns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mozex\\Campaigns\\CampaignsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
